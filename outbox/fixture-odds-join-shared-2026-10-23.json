{
 "what": "Recorded archive and vendor names for the same games, 2026-10-14..10-22: one archive row per game and the vendor event its odds_history row recorded. Used by scripts/check-odds-join-shared.mjs.",
 "exported": "2026-10-23, D1 field-archive (cc49101c), read-only",
 "query": "SELECT g.id, g.sport, g.date, g.home, g.away, g.start_time, oh.home_team, oh.away_team, oh.commence_time FROM odds_history oh JOIN (SELECT id, sport, date, home, away, start_time FROM regular_season_games UNION ALL SELECT id, sport, date, home, away, start_time FROM postseason_games) g ON g.id = oh.game_id WHERE oh.date BETWEEN 2026-10-14 AND 2026-10-22 AND g.sport IN (NBA,NHL,CFB,NFL,MLB,MLS,WNBA,CFL) GROUP BY g.id",
 "counts_by_sport": {
  "CFB": 36,
