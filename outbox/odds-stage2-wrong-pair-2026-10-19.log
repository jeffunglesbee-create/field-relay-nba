    // TASK 0.3 at 300eb6c2: every one-sided stored pair through the PRE-FIX matchSlate, reduced slate.
    import { readFileSync } from 'node:fs';
    import { matchSlate, nameMatches } from './odds-name-match.js';
    const rows = JSON.parse(readFileSync(process.argv[2], 'utf8')).rows;
    const tally = {};
    for (const r of rows) {
      const hh = nameMatches(r.a_home, r.v_home), aa = nameMatches(r.a_away, r.v_away);
      const ah = nameMatches(r.a_away, r.v_home), ha = nameMatches(r.a_home, r.v_away);
      if ((hh && aa) || (ah && ha) || !(hh || aa || ah || ha)) continue;
      const s = matchSlate([{ id: r.id, home: r.a_home, away: r.a_away }],
        [{ id: 'ev', home_team: r.v_home, away_team: r.v_away, commence_time: r.commence_time }], r.date);
      const m = s.byGameId.get(r.id);
      const k = m ? `PAIRED stage ${m.stage}` : 'REFUSED';
      tally[k] = (tally[k] || 0) + 1;
      const gap = Math.round((Date.parse(r.commence_time) - Date.parse(r.start_time)) / 60000);
      console.log(`  ${k} | gap ${Number.isFinite(gap) ? gap : 'n/a'} | ${r.id} | ${r.a_away} @ ${r.a_home} <- ${r.v_away} @ ${r.v_home}`);
    }
    console.log(`one-sided rows through the matcher at 300eb6c2: ${JSON.stringify(tally)}`);
